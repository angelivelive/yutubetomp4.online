---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConverterWidget from '../components/ConverterWidget.tsx';
---

<Layout 
  title="Yotube MP4 Converter - Download Yotube Videos Free | TubeToMP4"
  description="Looking for Yotube MP4 converter? Download videos from YouTube (Yotube) to MP4 format in HD quality. Fast, free, and easy to use - no registration required."
>
  <Header />
  
  <main class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-brand-red/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center space-y-8 animate-fade-in">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-brand-red text-sm font-medium mb-4">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-red opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-red"></span>
        </span>
        Did you mean: YouTube?
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
        Yotube to <span class="text-brand-red bg-clip-text text-transparent bg-gradient-to-r from-brand-red to-orange-500">MP4</span> Converter
      </h1>
      
      <p class="text-xl text-white/60 max-w-2xl mx-auto mb-10 leading-relaxed">
        Download videos from YouTube (often searched as "Yotube") to MP4 format in 1080p, 4K, and 8K quality. Fast, free, and no registration required.
      </p>

      <ConverterWidget client:load lang="en" />
    </div>
  </main>

  <section class="py-24 bg-brand-dark relative z-10 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">About Yotube MP4 Converter</h2>
        <p class="text-lg text-white/60 leading-relaxed">
           If you're searching for "Yotube MP4" or "Yotube to MP4", you've come to the right place! We understand that YouTube is sometimes spelled differently, and our converter works perfectly for downloading YouTube videos regardless of how you spell it.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-24">
         <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">High Quality</h3>
          <p class="text-white/50 text-sm leading-relaxed">Download videos in 360p, 720p, 1080p, 4K, and even 8K resolution.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">100% Free</h3>
          <p class="text-white/50 text-sm leading-relaxed">No hidden fees, no subscriptions, unlimited downloads for everyone.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">No Registration</h3>
          <p class="text-white/50 text-sm leading-relaxed">Start downloading immediately without creating an account or email.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">All Devices</h3>
          <p class="text-white/50 text-sm leading-relaxed">Works perfectly on Windows, Mac, Android, iOS, and any browser.</p>
        </div>
      </div>

      <!-- How to Section -->
      <div class="bg-gradient-to-br from-zinc-900 to-black border border-white/10 rounded-2xl p-8 md:p-12 mb-20">
         <div class="text-center mb-12">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">How to Download</h2>
            <p class="text-white/60">Follow these simple steps to download any Yotube video</p>
         </div>
         <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="flex flex-col items-center text-center">
               <div class="w-12 h-12 rounded-full bg-brand-red/20 text-brand-red font-bold text-xl flex items-center justify-center mb-4">1</div>
               <h3 class="text-lg font-bold text-white mb-2">Copy Yotube URL</h3>
               <p class="text-white/50 text-sm">Copy the video link from your browser or share menu.</p>
            </div>
            <div class="flex flex-col items-center text-center">
               <div class="w-12 h-12 rounded-full bg-brand-red/20 text-brand-red font-bold text-xl flex items-center justify-center mb-4">2</div>
               <h3 class="text-lg font-bold text-white mb-2">Paste & Start</h3>
               <p class="text-white/50 text-sm">Paste the link into the converter box above.</p>
            </div>
            <div class="flex flex-col items-center text-center">
               <div class="w-12 h-12 rounded-full bg-brand-red/20 text-brand-red font-bold text-xl flex items-center justify-center mb-4">3</div>
               <h3 class="text-lg font-bold text-white mb-2">Download MP4</h3>
               <p class="text-white/50 text-sm">Select quality and save the file to your device.</p>
            </div>
         </div>
      </div>

      <!-- Keywords / Tags Section -->
      <div class="border-t border-white/5 pt-12">
        <div class="text-center max-w-3xl mx-auto">
          <h3 class="text-lg font-semibold text-white/80 mb-6">Common Search Variations</h3>
          <div class="flex flex-wrap justify-center gap-3">
{["Yotube MP4", "Yotube to MP4", "Yuotube to MP4", "Youtubve to MP4", "Youtune MP4", "Youtube Videos", "YT to MP4", "Tube to MP4"].map((tag) => (
              <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/50 text-sm hover:text-white hover:border-white/20 transition-all cursor-default">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
