---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConverterWidget from '../components/ConverterWidget.tsx';
---

<Layout 
  title="YouTube URL to MP4 - Convert YouTube Links to MP4 | TubeToMP4"
  description="Convert any YouTube URL to MP4 format instantly. Paste your YouTube link and download videos in HD quality. Fast, free, and easy URL to MP4 conversion."
>
  <Header />
  
  <main class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-brand-red/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center space-y-8 animate-fade-in">
       <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-medium mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
           <path d="M12.232 4.232a2.5 2.5 0 013.536 3.536l-1.225 1.224a.75.75 0 001.061 1.06l1.224-1.224a4 4 0 00-5.656-5.656l-3 3a4 4 0 00.225 5.865.75.75 0 00.977-1.138 2.5 2.5 0 01-.142-3.667l3-3z" />
           <path d="M11.603 7.963a.75.75 0 00-.977 1.138 2.5 2.5 0 01.142 3.667l-3 3a2.5 2.5 0 01-3.536-3.536l1.225-1.224a.75.75 0 00-1.061-1.06l-1.224 1.224a4 4 0 105.656 5.656l3-3a4 4 0 00-.225-5.865z" />
        </svg>
        Universal URL Support
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
        YouTube <span class="text-brand-red bg-clip-text text-transparent bg-gradient-to-r from-brand-red to-orange-500">URL</span> to MP4
      </h1>
      
      <p class="text-xl text-white/60 max-w-2xl mx-auto mb-10 leading-relaxed">
        Convert any YouTube URL to MP4 in seconds. Simply paste your YouTube link and download videos in your preferred quality. Works with all YouTube URLs.
      </p>

      <ConverterWidget client:load lang="en" />
    </div>
  </main>

  <section class="py-24 bg-brand-dark relative z-10 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Convert YouTube URL to MP4</h2>
        <p class="text-lg text-white/60 leading-relaxed">
          Our YouTube URL to MP4 converter makes it incredibly easy to download videos. Just copy any YouTube URL - short, long, or mobile - and we'll handle the rest!
        </p>
      </div>

      <!-- URL Types Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
         <div class="bg-white/5 border border-white/5 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-blue-500"></span>
               Standard URLs
            </h3>
            <p class="text-white/50 text-sm font-mono bg-black/30 p-3 rounded-lg border border-white/5 mb-3">youtube.com/watch?v=...</p>
            <p class="text-white/60 text-sm">The classic desktop URL format found in your browser bar.</p>
         </div>

         <div class="bg-white/5 border border-white/5 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-blue-500"></span>
               Short URLs
            </h3>
            <p class="text-white/50 text-sm font-mono bg-black/30 p-3 rounded-lg border border-white/5 mb-3">youtu.be/ID</p>
            <p class="text-white/60 text-sm">The share link format used for sharing on social media.</p>
         </div>

         <div class="bg-white/5 border border-white/5 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-blue-500"></span>
               Mobile URLs
            </h3>
            <p class="text-white/50 text-sm font-mono bg-black/30 p-3 rounded-lg border border-white/5 mb-3">m.youtube.com/...</p>
            <p class="text-white/60 text-sm">Links copied from mobile browsers or devices.</p>
         </div>
      </div>

       <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-24 items-center">
        <!-- How To Steps -->
        <div>
           <h2 class="text-3xl font-bold text-white mb-8">How to Convert</h2>
            <div class="space-y-6">
              <div class="flex gap-4 group">
                 <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-white font-bold flex items-center justify-center group-hover:bg-brand-red group-hover:border-brand-red transition-all duration-300">1</div>
                 <div>
                    <h3 class="text-xl font-semibold text-white mb-2">Copy URL</h3>
                    <p class="text-white/60">Copy the full YouTube link from your browser.</p>
                 </div>
              </div>
              <div class="flex gap-4 group">
                 <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-white font-bold flex items-center justify-center group-hover:bg-brand-red group-hover:border-brand-red transition-all duration-300">2</div>
                 <div>
                    <h3 class="text-xl font-semibold text-white mb-2">Paste Link</h3>
                    <p class="text-white/60">Insert the link into our converter tool.</p>
                 </div>
              </div>
              <div class="flex gap-4 group">
                 <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-white font-bold flex items-center justify-center group-hover:bg-brand-red group-hover:border-brand-red transition-all duration-300">3</div>
                 <div>
                    <h3 class="text-xl font-semibold text-white mb-2">Download</h3>
                    <p class="text-white/60">Choose standard or HD quality and save.</p>
                 </div>
              </div>
            </div>
        </div>
        
        <!-- Benefits Grid -->
        <div class="grid grid-cols-2 gap-4">
           <div class="bg-gradient-to-br from-zinc-900 to-black border border-white/10 rounded-2xl p-6 text-center">
              <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                 <svg class="w-6 h-6 text-brand-red" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <h3 class="font-bold text-white">Instant</h3>
              <p class="text-xs text-white/50 mt-1">Loads in milliseconds</p>
           </div>
           <div class="bg-gradient-to-br from-zinc-900 to-black border border-white/10 rounded-2xl p-6 text-center">
              <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                 <svg class="w-6 h-6 text-brand-red" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
              </div>
              <h3 class="font-bold text-white">Secure</h3>
              <p class="text-xs text-white/50 mt-1">HTTPS Encryption</p>
           </div>
           <div class="bg-gradient-to-br from-zinc-900 to-black border border-white/10 rounded-2xl p-6 text-center">
              <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                 <svg class="w-6 h-6 text-brand-red" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
              <h3 class="font-bold text-white">HD Free</h3>
              <p class="text-xs text-white/50 mt-1">Up to 4K Quality</p>
           </div>
           <div class="bg-gradient-to-br from-zinc-900 to-black border border-white/10 rounded-2xl p-6 text-center">
              <div class="w-10 h-10 bg-brand-red/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                 <svg class="w-6 h-6 text-brand-red" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
              </div>
              <h3 class="font-bold text-white">Mobile</h3>
              <p class="text-xs text-white/50 mt-1">Phone Optimized</p>
           </div>
        </div>
      </div>

      <div class="border-t border-white/5 pt-12">
        <div class="text-center max-w-3xl mx-auto">
          <h3 class="text-lg font-semibold text-white/80 mb-6">Supported Formats</h3>
          <div class="flex flex-wrap justify-center gap-3">
            {["Standard URL", "Share Link", "Mobile Link", "Playlist URL", "Channel URL", "Shorts Link", "Embed URL"].map((tag) => (
              <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/50 text-sm hover:text-white hover:border-white/20 transition-all cursor-default">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
