---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConverterWidget from '../components/ConverterWidget.tsx';
---

<Layout 
  title="YTB to MP4 - Convert YouTube (YTB) Videos to MP4 | TubeToMP4"
  description="Convert YTB (YouTube) videos to MP4 format. Fast and free YTB to MP4 converter with HD quality downloads. No registration required."
>
  <Header />
  
  <main class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-brand-red/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center space-y-8 animate-fade-in">
       <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-white/60 text-sm font-medium mb-4">
        <span class="w-2 h-2 rounded-full bg-brand-red"></span>
        YTB = YouTube
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
        YTB to <span class="text-brand-red bg-clip-text text-transparent bg-gradient-to-r from-brand-red to-orange-500">MP4</span>
      </h1>
      
      <p class="text-xl text-white/60 max-w-2xl mx-auto mb-10 leading-relaxed">
        Convert YTB (YouTube) videos to MP4 format in seconds. Download from YouTube in HD, 1080p, 4K quality. Free and easy to use.
      </p>

      <ConverterWidget client:load lang="en" />
    </div>
  </main>

  <section class="py-24 bg-brand-dark relative z-10 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">What is a YTB Converter?</h2>
        <p class="text-lg text-white/60 leading-relaxed">
          "YTB" is a popular abbreviation for YouTube. Our tool is specifically designed to recognize this shorthand and help you download any YouTube video as high-quality MP4 files for offline viewing.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-24">
         <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <span class="text-brand-red font-bold text-xl">4K</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">YTB 4K Support</h3>
          <p class="text-white/50 text-sm leading-relaxed">Download YTB videos in their full original resolution.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Fast YTB Engine</h3>
          <p class="text-white/50 text-sm leading-relaxed">Our specialized servers process YTB links in milliseconds.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Unlimited</h3>
          <p class="text-white/50 text-sm leading-relaxed">No matter how many YTB videos you need, it's always free.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 5.523-4.477 10-10 10S1 17.523 1 12 5.477 2 11 2s10 4.477 10 10z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Simple</h3>
          <p class="text-white/50 text-sm leading-relaxed">No complex steps. Just Paste YTB Link -> Click Download.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-24 items-center">
        <!-- How To Card -->
        <div class="bg-gradient-to-br from-zinc-900 to-black border border-white/10 rounded-2xl p-8">
           <h3 class="text-2xl font-bold text-white mb-8">How to Convert YTB to MP4</h3>
           <div class="relative pl-8 border-l border-white/10 space-y-10">
              <div class="relative">
                 <span class="absolute -left-[41px] flex h-6 w-6 items-center justify-center rounded-full bg-brand-red text-xs font-bold text-white ring-4 ring-brand-dark">1</span>
                 <h4 class="text-lg font-bold text-white mb-2">Find YTB Video</h4>
                 <p class="text-white/60">Browse YouTube as normal and find your video.</p>
              </div>
              <div class="relative">
                 <span class="absolute -left-[41px] flex h-6 w-6 items-center justify-center rounded-full bg-brand-red text-xs font-bold text-white ring-4 ring-brand-dark">2</span>
                 <h4 class="text-lg font-bold text-white mb-2">Copy Link</h4>
                 <p class="text-white/60">Copy the URL from the top of your browser.</p>
              </div>
               <div class="relative">
                 <span class="absolute -left-[41px] flex h-6 w-6 items-center justify-center rounded-full bg-brand-red text-xs font-bold text-white ring-4 ring-brand-dark">3</span>
                 <h4 class="text-lg font-bold text-white mb-2">Download</h4>
                 <p class="text-white/60">Paste here and save your MP4 file.</p>
              </div>
           </div>
        </div>
        
        <!-- Info -->
        <div>
           <h2 class="text-3xl font-bold text-white mb-6">Why YTB?</h2>
           <p class="text-white/60 leading-relaxed mb-8">
              "YTB" is strictly an abbreviation for YouTube used by millions online. While the name is shorter, our commitment to quality is not. We ensure every YTB link gets converted with the same premium engine used for full YouTube URLs.
           </p>
           <div class="grid grid-cols-2 gap-4">
              <div class="p-4 rounded-xl bg-white/5 border border-white/5">
                 <div class="font-bold text-white mb-1">YTB Music</div>
                 <div class="text-xs text-white/50">Fully Supported</div>
              </div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/5">
                 <div class="font-bold text-white mb-1">YTB Shorts</div>
                 <div class="text-xs text-white/50">Fully Supported</div>
              </div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/5">
                 <div class="font-bold text-white mb-1">YTB Live</div>
                 <div class="text-xs text-white/50">Supported (Archived)</div>
              </div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/5">
                 <div class="font-bold text-white mb-1">YTB Kids</div>
                 <div class="text-xs text-white/50">Fully Supported</div>
              </div>
           </div>
        </div>
      </div>

      <div class="border-t border-white/5 pt-12">
        <div class="text-center max-w-3xl mx-auto">
          <h3 class="text-lg font-semibold text-white/80 mb-6">Popular YTB Tags</h3>
          <div class="flex flex-wrap justify-center gap-3">
{["YTB Converter", "YTB Downloader", "ytmp34", "YTB MP3", "YTB MP4", "YTB to MP3", "YTB Video", "Save YTB"].map((tag) => (
              <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/50 text-sm hover:text-white hover:border-white/20 transition-all cursor-default">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
