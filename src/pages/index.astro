---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConverterWidget from '../components/ConverterWidget.tsx';

// HowTo Schema for Bing & Google Rich Results
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Download YouTube Videos to MP4",
  description: "Learn how to convert and download YouTube videos to MP4 format using TubeToMP4. Fast, free, and supports HD quality up to 4K.",
  image: "https://www.yutubetomp4.online/favicon.png",
  totalTime: "PT2M",
  estimatedCost: {
    "@type": "MonetaryAmount",
    currency: "USD",
    value: "0",
  },
  tool: [
    {
      "@type": "HowToTool",
      name: "Web Browser",
    },
    {
      "@type": "HowToTool",
      name: "TubeToMP4 Converter",
    },
  ],
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Copy the Video URL",
      text: "Open YouTube and copy the URL of the video you want to download.",
      url: "https://www.yutubetomp4.online/#step1",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Paste the Link",
      text: "Paste the YouTube link into the search box above and click Start.",
      url: "https://www.yutubetomp4.online/#step2",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Select Quality",
      text: "Choose your preferred video quality (360p, 480p, 720p, 1080p, 4K).",
      url: "https://www.yutubetomp4.online/#step3",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Download",
      text: "Click the Download button and save the file to your device.",
      url: "https://www.yutubetomp4.online/#step4",
    },
    {
      "@type": "HowToStep",
      position: 5,
      name: "Enjoy Offline",
      text: "Watch your downloaded video anytime, anywhere - no internet required.",
      url: "https://www.yutubetomp4.online/#step5",
    },
  ],
};

// VideoObject Schema for Bing Video Search (with freshness signals)
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "How to Convert YouTube to MP4 - TubeToMP4 Tutorial",
  description: "Learn how to use TubeToMP4 to convert and download YouTube videos to MP4 format in HD quality. Free, fast, no registration required.",
  thumbnailUrl: "https://www.yutubetomp4.online/favicon.png",
  uploadDate: "2024-01-01T00:00:00+00:00",
  duration: "PT2M",
  contentUrl: "https://www.yutubetomp4.online/",
  embedUrl: "https://www.yutubetomp4.online/",
  publisher: {
    "@type": "Organization",
    name: "TubeToMP4",
    url: "https://www.yutubetomp4.online",
    logo: {
      "@type": "ImageObject",
      url: "https://www.yutubetomp4.online/favicon.png",
    },
  },
};
---

<Layout
  title="YouTube to MP4 Converter - Fast, Free & Premium Quality | TubeToMP4"
  description="Free YouTube to MP4 converter. Download YouTube videos to MP4 in HD 1080p, 4K, and 8K quality. No registration required. Fast, safe, unlimited YouTube to MP4 downloads."
  keywords="youtube to mp4, youtube converter, youtube downloader, mp4 converter, video downloader, free youtube download, 4k video download, hd video converter"
>
  <Header />

  <!-- HowTo & Video Schema for Bing Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

  <main class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <!-- Background Accents -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-brand-red/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center space-y-8 animate-fade-in">
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
        YouTube to MP4 <span class="text-brand-red bg-clip-text text-transparent bg-gradient-to-r from-brand-red to-orange-500">Converter</span>
      </h1>

      <!-- AEO Direct Answer Block: AI engines extract this as the definitive answer -->
      <p class="speakable-answer text-xl text-white/60 max-w-2xl mx-auto mb-10 leading-relaxed" data-speakable="true">
        TubeToMP4 is a free YouTube to MP4 converter that lets you download YouTube videos in HD 1080p, 4K, and 8K quality. No registration, no ads, and no software installation required. Simply paste a YouTube URL, select your quality, and download instantly on any device.
      </p>

      <!-- Converter Widget Island -->
      <ConverterWidget client:load lang="en" />
      
      <p class="text-xs text-white/30 uppercase tracking-widest font-medium pt-4">
        By using our service you agree to our <a href="/terms" class="text-white/50 hover:text-white underline decoration-white/30 transition-colors">Terms of Service</a>
      </p>
    </div>
  </main>

  <!-- How to Download Section -->
  <section id="how-to" class="py-20 bg-gradient-to-b from-brand-dark to-zinc-900/50 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- How to Download -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-8">How to Download YouTube Videos to MP4</h2>
          <ol class="space-y-6">
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 bg-brand-red/20 rounded-full flex items-center justify-center text-brand-red font-bold text-sm">1</span>
              <div>
                <h3 class="text-white font-semibold mb-1">Copy the Video URL</h3>
                <p class="text-white/50 text-sm">Open YouTube and copy the URL of the video you want to download.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 bg-brand-red/20 rounded-full flex items-center justify-center text-brand-red font-bold text-sm">2</span>
              <div>
                <h3 class="text-white font-semibold mb-1">Paste the Link</h3>
                <p class="text-white/50 text-sm">Paste the YouTube link into the search box above and click "Start".</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 bg-brand-red/20 rounded-full flex items-center justify-center text-brand-red font-bold text-sm">3</span>
              <div>
                <h3 class="text-white font-semibold mb-1">Select Quality</h3>
                <p class="text-white/50 text-sm">Choose your preferred video quality (360p, 480p, 720p, 1080p, 4K).</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 bg-brand-red/20 rounded-full flex items-center justify-center text-brand-red font-bold text-sm">4</span>
              <div>
                <h3 class="text-white font-semibold mb-1">Download</h3>
                <p class="text-white/50 text-sm">Click the "Download" button and save the file to your device.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 bg-brand-red/20 rounded-full flex items-center justify-center text-brand-red font-bold text-sm">5</span>
              <div>
