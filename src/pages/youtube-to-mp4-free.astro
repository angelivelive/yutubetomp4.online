---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConverterWidget from '../components/ConverterWidget.tsx';
---

<Layout 
  title="YouTube to MP4 Free - Download YouTube Videos Free | TubeToMP4"
  description="Free YouTube to MP4 converter - download YouTube videos in MP4 format without paying. 100% free, no registration, unlimited downloads in HD quality."
>
  <Header />
  
  <main class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-brand-red/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center space-y-8 animate-fade-in">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-sm font-medium mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        100% Free Forever
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
        YouTube to MP4 <span class="text-brand-red bg-clip-text text-transparent bg-gradient-to-r from-brand-red to-orange-500">Free</span>
      </h1>
      
      <p class="text-xl text-white/60 max-w-2xl mx-auto mb-10 leading-relaxed">
        Download YouTube videos to MP4 completely free. No hidden charges, no subscriptions, no limits. Convert and download unlimited videos in HD quality.
      </p>

      <ConverterWidget client:load lang="en" />
    </div>
  </main>

  <section class="py-24 bg-brand-dark relative z-10 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Truly Free YouTube Converter</h2>
        <p class="text-lg text-white/60 leading-relaxed">
          Looking for a truly free YouTube to MP4 converter? You've found it! TubeToMP4 is fully free with no hidden costs, no premium tiers, and no download limits.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-24">
        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-green-500/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-green-500/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-green-500">
               <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">No Hidden Fees</h3>
          <p class="text-white/50 text-sm leading-relaxed">Unlike other "free" converters that charge for HD quality, we offer everything completely free.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Unlimited & Fast</h3>
          <p class="text-white/50 text-sm leading-relaxed">Download as many videos as you need. No daily limits, no waiting times.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 5.523-4.477 10-10 10S1 17.523 1 12 5.477 2 11 2s10 4.477 10 10z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">HD Quality Free</h3>
          <p class="text-white/50 text-sm leading-relaxed">Get videos in 1080p, 4K, and even 8K resolution without paying a cent.</p>
        </div>

        <div class="group bg-white/5 border border-white/5 rounded-2xl p-8 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 bg-brand-red/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-brand-red/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-brand-red">
               <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">No Registration</h3>
          <p class="text-white/50 text-sm leading-relaxed">No email required, no account creation. Just paste and download.</p>
        </div>
      </div>

       <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-24 items-center">
        <!-- Feature List -->
        <div>
           <h2 class="text-3xl font-bold text-white mb-8">What's Included For Free</h2>
            <ul class="space-y-4">
               <li class="flex items-start gap-4 p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
                  <div class="flex-shrink-0 w-6 h-6 rounded-full bg-green-500/20 text-green-500 flex items-center justify-center mt-1">✓</div>
                  <div>
                     <h3 class="font-bold text-white">4K & 8K Downloading</h3>
                     <p class="text-sm text-white/50">Most converters charge for this. We don't.</p>
                  </div>
               </li>
               <li class="flex items-start gap-4 p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
                  <div class="flex-shrink-0 w-6 h-6 rounded-full bg-green-500/20 text-green-500 flex items-center justify-center mt-1">✓</div>
                  <div>
                     <h3 class="font-bold text-white">Full Playlist Support</h3>
                     <p class="text-sm text-white/50">Download multiple videos at once without limits.</p>
                  </div>
               </li>
               <li class="flex items-start gap-4 p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
                  <div class="flex-shrink-0 w-6 h-6 rounded-full bg-green-500/20 text-green-500 flex items-center justify-center mt-1">✓</div>
                  <div>
                     <h3 class="font-bold text-white">No Watermarks</h3>
                     <p class="text-sm text-white/50">Clean video files with no added branding.</p>
                  </div>
               </li>
            </ul>
        </div>
        
        <!-- How To Card -->
        <div class="bg-gradient-to-br from-zinc-900 to-black border border-white/10 rounded-2xl p-8">
           <h3 class="text-2xl font-bold text-white mb-6">How It Works</h3>
           <div class="space-y-6">
              <div class="flex gap-4">
                 <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-red/20 text-brand-red font-bold flex items-center justify-center">1</div>
                 <p class="text-white/70 py-1">Copy video URL from YouTube</p>
              </div>
              <div class="flex gap-4">
                 <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-red/20 text-brand-red font-bold flex items-center justify-center">2</div>
                 <p class="text-white/70 py-1">Paste into the box above</p>
              </div>
              <div class="flex gap-4">
                 <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-red/20 text-brand-red font-bold flex items-center justify-center">3</div>
                 <p class="text-white/70 py-1">Click Start & Download Free</p>
              </div>
           </div>
        </div>
      </div>

      <div class="border-t border-white/5 pt-12">
        <div class="text-center max-w-3xl mx-auto">
          <h3 class="text-lg font-semibold text-white/80 mb-6">Free Forever Features</h3>
          <div class="flex flex-wrap justify-center gap-3">
            {["No Ads", "No Limits", "High Speed", "Secure", "Private", "HD Quality", "Mobile Friendly"].map((tag) => (
              <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/50 text-sm hover:text-white hover:border-white/20 transition-all cursor-default">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
