---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConverterWidget from '../../components/ConverterWidget.tsx';
import { languages, type Language } from '../../i18n/translations';

export function getStaticPaths() {
  return Object.keys(languages).filter(l => l !== 'en').map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

const isSpanish = lang === 'es';

const title = isSpanish 
  ? "Convertidor de YouTube a MP4 - Guía Definitiva y Herramienta Gratuita (2026)"
  : "YouTube to MP4 Converter - The Ultimate Guide (2026)";

const description = isSpanish
  ? "Aprende cómo convertir videos de YouTube a MP4 con nuestra guía completa. Descargas ilimitadas en HD, 4K y 8K sin registro."
  : "Learn how to use the best YouTube to MP4 online converter. Download videos in 1080p, 4K, and 8K completely free. Comprehensive guide and tips.";
---

<Layout title={title} description={description}>
  <Header />
  
  <main class={`flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 ${isSpanish ? 'relative overflow-hidden' : 'bg-brand-dark'}`}>
    {isSpanish ? (
      <>
        <!-- Spanish Content -->
        <div class="max-w-4xl mx-auto text-center space-y-8 mb-20">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
            El Mejor <span class="text-brand-red">Convertidor de YouTube a MP4</span>
